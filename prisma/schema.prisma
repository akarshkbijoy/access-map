generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model APP_USER {
  user_id         BigInt          @id @default(autoincrement())
  username        String          @unique @db.VarChar(50)
  password        String          @db.VarChar(100)
  name            String?         @db.VarChar(100)
  dob             DateTime?       @db.Date
  address         String?         @db.VarChar(255)
  phone           String?         @db.VarChar(20)
  email           String?         @unique @db.VarChar(100)
  role            String?         @default("user") @db.VarChar(20)
  disabilityType  String?         @db.VarChar(100)
  description     String?         @db.VarChar(1000)

  userLocations   USER_LOCATION[]
  contributions   CONTRIBUTION[]  @relation("UserContributions")
  reviews         CONTRIBUTION[]  @relation("AdminReviews")
  uploadedPhotos  LOCATION_PHOTO[] @relation("PhotoUploader")
  reviewedPhotos  LOCATION_PHOTO[] @relation("PhotoReviewer")
  businessClaims  BUSINESS_CLAIM[]
  ownedLocations  LOCATION[]      @relation("LocationOwner")
}

model LOCATION {
  location_id          BigInt                  @id @default(autoincrement())
  name                 String                  @db.VarChar(150)
  address              String?                 @db.VarChar(255)
  latitude             Decimal?                @db.Decimal(10, 6)
  longitude            Decimal?                @db.Decimal(10, 6)
  geom                 Unsupported("geography(Point, 4326)")?
  description          String?                 @db.VarChar(1000)
  contact              String?                 @db.VarChar(100)
  rating               Decimal?                @db.Decimal(3, 2)
  lastUpdated          DateTime?               @db.Timestamptz
  accessibilityScore   Decimal?                @db.Decimal(3, 2)
  status               String?                 @default("pending") @db.VarChar(20)
  flagCount            Int?                    @default(0)
  owner_id             BigInt?
  is_claimed           Boolean?                @default(false)

  features             ACCESSIBILITY_FEATURE[]
  userLocations        USER_LOCATION[]
  contributions        CONTRIBUTION[]
  photos               LOCATION_PHOTO[]
  owner                APP_USER?               @relation("LocationOwner", fields: [owner_id], references: [user_id])
  claims               BUSINESS_CLAIM[]
  dashboardModules     DASHBOARD_MODULE[]
  campusBuildings      CAMPUS_BUILDING[]
  alerts               LOCATION_ALERT[]
}

model ACCESSIBILITY_FEATURE {
  feature_id            BigInt   @id @default(autoincrement())
  location_id           BigInt
  wheelchairAccessible  Boolean? @default(false)
  accessibleRestrooms   Boolean? @default(false)
  accessibleParking     Boolean? @default(false)
  rampAccess            Boolean? @default(false)
  elevatorAccess        Boolean? @default(false)
  visualAudioAssistance Boolean? @default(false)
  wideDoorways          Boolean? @default(false)
  levelSurfaces         Boolean? @default(false)

  location              LOCATION @relation(fields: [location_id], references: [location_id])
}

model USER_LOCATION {
  user_location_id BigInt @id @default(autoincrement())
  user_id          BigInt
  location_id      BigInt

  user             APP_USER @relation(fields: [user_id], references: [user_id])
  location         LOCATION @relation(fields: [location_id], references: [location_id])
}

model CONTRIBUTION {
  contribution_id  BigInt    @id @default(autoincrement())
  location_id      BigInt
  user_id          BigInt
  media_urls       String[]  @db.Text
  comment          String?
  feature_snapshot Json?     @db.JsonB
  status           String?   @default("pending") @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamptz
  reviewed_by      BigInt?
  reviewed_at      DateTime? @db.Timestamptz

  location         LOCATION  @relation(fields: [location_id], references: [location_id])
  user             APP_USER  @relation("UserContributions", fields: [user_id], references: [user_id])
  admin            APP_USER? @relation("AdminReviews", fields: [reviewed_by], references: [user_id])
}

model LOCATION_PHOTO {
  photo_id          BigInt    @id @default(autoincrement())
  location_id       BigInt
  user_id           BigInt
  url               String    @db.Text
  caption           String?   @db.VarChar(255)
  status            String?   @default("pending") @db.VarChar(20)
  created_at        DateTime? @default(now()) @db.Timestamptz
  reviewed_by       BigInt?
  reviewed_at       DateTime? @db.Timestamptz
  declared_classes  String[]  @db.Text
  ml_analysis       Json?     @db.JsonB
  ml_pushed         Boolean?  @default(false)

  location     LOCATION  @relation(fields: [location_id], references: [location_id])
  user         APP_USER  @relation("PhotoUploader", fields: [user_id], references: [user_id])
  reviewer     APP_USER? @relation("PhotoReviewer", fields: [reviewed_by], references: [user_id])
}

model BUSINESS_CLAIM {
  claim_id          BigInt    @id @default(autoincrement())
  location_id       BigInt
  user_id           BigInt
  business_name     String    @db.VarChar(150)
  claimant_name     String    @db.VarChar(100)
  claimant_role     String    @db.VarChar(100)
  contact_email     String    @db.VarChar(100)
  contact_phone     String    @db.VarChar(20)
  verification_docs String[]  @db.Text
  notes             String?   @db.Text
  status            String    @default("pending") @db.VarChar(20) // 'pending', 'verified', 'declined'
  created_at        DateTime? @default(now()) @db.Timestamptz
  reviewed_by       BigInt?
  reviewed_at       DateTime? @db.Timestamptz

  location          LOCATION  @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  user              APP_USER  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model DASHBOARD_MODULE {
  module_id         BigInt    @id @default(autoincrement())
  location_id       BigInt
  module_type       String    @db.VarChar(50) // 'overview', 'campus_levels', 'features_deep_dive', 'alerts', 'sensory_guide', 'transit_parking', 'services'
  is_enabled        Boolean   @default(true)
  display_order     Int       @default(0)
  title             String?   @db.VarChar(100)
  content           Json?     @db.JsonB
  updated_at        DateTime? @default(now()) @updatedAt @db.Timestamptz

  location          LOCATION  @relation(fields: [location_id], references: [location_id], onDelete: Cascade)

  @@unique([location_id, module_type])
}

model CAMPUS_BUILDING {
  building_id       BigInt    @id @default(autoincrement())
  location_id       BigInt
  name              String    @db.VarChar(100)
  description       String?   @db.VarChar(500)
  total_floors      Int       @default(1)
  display_order     Int       @default(0)

  location          LOCATION  @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  floors            CAMPUS_FLOOR[]
}

model CAMPUS_FLOOR {
  floor_id          BigInt    @id @default(autoincrement())
  building_id       BigInt
  floor_number      Int
  floor_name        String    @db.VarChar(100)
  map_image_url     String?   @db.Text
  description       String?   @db.VarChar(500)

  building          CAMPUS_BUILDING @relation(fields: [building_id], references: [building_id], onDelete: Cascade)
  pois              FLOOR_POI[]
}

model FLOOR_POI {
  poi_id            BigInt    @id @default(autoincrement())
  floor_id          BigInt
  name              String    @db.VarChar(100)
  category          String    @db.VarChar(50) // 'elevator', 'restroom', 'ramp', 'tactile_path', 'help_desk', 'quiet_room', 'parking'
  x_coord           Decimal?  @db.Decimal(5, 2)
  y_coord           Decimal?  @db.Decimal(5, 2)
  description       String?   @db.VarChar(255)

  floor             CAMPUS_FLOOR @relation(fields: [floor_id], references: [floor_id], onDelete: Cascade)
}

model LOCATION_ALERT {
  alert_id          BigInt    @id @default(autoincrement())
  location_id       BigInt
  title             String    @db.VarChar(150)
  message           String    @db.Text
  severity          String    @default("info") @db.VarChar(20) // 'info', 'warning', 'critical'
  is_active         Boolean   @default(true)
  starts_at         DateTime? @default(now()) @db.Timestamptz
  expires_at        DateTime? @db.Timestamptz
  created_at        DateTime? @default(now()) @db.Timestamptz

  location          LOCATION  @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
}
