generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model APP_USER {
  user_id         BigInt          @id @default(autoincrement())
  username        String          @unique @db.VarChar(50)
  password        String          @db.VarChar(100)
  name            String?         @db.VarChar(100)
  dob             DateTime?       @db.Date
  address         String?         @db.VarChar(255)
  phone           String?         @db.VarChar(20)
  email           String?         @unique @db.VarChar(100)
  disabilityType  String?         @db.VarChar(100)
  description     String?         @db.VarChar(1000)

  userLocations   USER_LOCATION[]
  contributions   CONTRIBUTION[]  @relation("UserContributions")
  reviews         CONTRIBUTION[]  @relation("AdminReviews")
  uploadedPhotos  LOCATION_PHOTO[] @relation("PhotoUploader")
  reviewedPhotos  LOCATION_PHOTO[] @relation("PhotoReviewer")
}

model LOCATION {
  location_id          BigInt                  @id @default(autoincrement())
  name                 String                  @db.VarChar(150)
  address              String?                 @db.VarChar(255)
  latitude             Decimal?                @db.Decimal(10, 6)
  longitude            Decimal?                @db.Decimal(10, 6)
  geom                 Unsupported("geography(Point, 4326)")?
  description          String?                 @db.VarChar(1000)
  contact              String?                 @db.VarChar(100)
  rating               Decimal?                @db.Decimal(3, 2)
  lastUpdated          DateTime?               @db.Timestamptz
  accessibilityScore   Decimal?                @db.Decimal(3, 2)
  status               String?                 @default("pending") @db.VarChar(20)
  flagCount            Int?                    @default(0)

  features             ACCESSIBILITY_FEATURE[]
  userLocations        USER_LOCATION[]
  contributions        CONTRIBUTION[]
  photos               LOCATION_PHOTO[]
}

model ACCESSIBILITY_FEATURE {
  feature_id            BigInt   @id @default(autoincrement())
  location_id           BigInt
  wheelchairAccessible  Boolean? @default(false)
  accessibleRestrooms   Boolean? @default(false)
  accessibleParking     Boolean? @default(false)
  rampAccess            Boolean? @default(false)
  elevatorAccess        Boolean? @default(false)
  visualAudioAssistance Boolean? @default(false)
  wideDoorways          Boolean? @default(false)
  levelSurfaces         Boolean? @default(false)

  location              LOCATION @relation(fields: [location_id], references: [location_id])
}

model USER_LOCATION {
  user_location_id BigInt @id @default(autoincrement())
  user_id          BigInt
  location_id      BigInt

  user             APP_USER @relation(fields: [user_id], references: [user_id])
  location         LOCATION @relation(fields: [location_id], references: [location_id])
}

model CONTRIBUTION {
  contribution_id  BigInt    @id @default(autoincrement())
  location_id      BigInt
  user_id          BigInt
  media_urls       String[]  @db.Text
  comment          String?
  feature_snapshot Json?     @db.JsonB
  status           String?   @default("pending") @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamptz
  reviewed_by      BigInt?
  reviewed_at      DateTime? @db.Timestamptz

  location         LOCATION  @relation(fields: [location_id], references: [location_id])
  user             APP_USER  @relation("UserContributions", fields: [user_id], references: [user_id])
  admin            APP_USER? @relation("AdminReviews", fields: [reviewed_by], references: [user_id])
}

model LOCATION_PHOTO {
  photo_id          BigInt    @id @default(autoincrement())
  location_id       BigInt
  user_id           BigInt
  url               String    @db.Text
  caption           String?   @db.VarChar(255)
  status            String?   @default("pending") @db.VarChar(20)
  created_at        DateTime? @default(now()) @db.Timestamptz
  reviewed_by       BigInt?
  reviewed_at       DateTime? @db.Timestamptz
  declared_classes  String[]  @db.Text
  ml_analysis       Json?     @db.JsonB
  ml_pushed         Boolean?  @default(false)

  location     LOCATION  @relation(fields: [location_id], references: [location_id])
  user         APP_USER  @relation("PhotoUploader", fields: [user_id], references: [user_id])
  reviewer     APP_USER? @relation("PhotoReviewer", fields: [reviewed_by], references: [user_id])
}
