# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============================================
# Python & Machine Learning (access-map-ml)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
venv/
env/
.ipynb_checkpoints/

# ML Datasets & Annotations (heavy data)
**/data/raw/
**/data/processed/
**/access-map-stairs/

# ML Model Weights & Checkpoints (large binary files)
*.pt
*.onnx
*.tflite
*.engine
**/runs/
**/models/*.pt
**/models/*.onnx
**/models/*.tflite
**/models/*.engine

# ML Logs
**/logs/
*.log

